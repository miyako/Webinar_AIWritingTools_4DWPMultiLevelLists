{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 0,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onPageChange",
		"onValidate",
		"onClick",
		"onDoubleClick",
		"onOutsideCall",
		"onBeginDragOver",
		"onDragOver",
		"onDrop",
		"onAfterKeystroke",
		"onMenuSelect",
		"onPluginArea",
		"onAfterEdit",
		"onTimer",
		"onBoundVariableChange"
	],
	"windowTitle": "4D Write Pro: AI Writing Tools & Multi-Level Lists",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {
				"DemoTabs": {
					"type": "tab",
					"top": 12,
					"left": 224,
					"width": 852,
					"height": 28,
					"sizingX": "grow",
					"labels": [
						"Introduction",
						"Write Pro"
					],
					"action": "gotoPage"
				},
				"Static Picture2": {
					"type": "picture",
					"top": 50,
					"left": 16,
					"width": 1341,
					"height": 800,
					"picture": "/RESOURCES/IntroIcons/WebinarIntro_Background.png",
					"pictureFormat": "scaled",
					"class": "light-only"
				}
			}
		},
		{
			"objects": {
				"WelcomeBackground": {
					"type": "picture",
					"top": 50,
					"left": 16,
					"width": 1341,
					"height": 800,
					"picture": "/RESOURCES/IntroIcons/WebinarIntro_Background.png",
					"pictureFormat": "scaled"
				},
				"WebinarTitle": {
					"type": "text",
					"top": 255,
					"left": 277,
					"width": 819,
					"height": 54,
					"sizingX": "grow",
					"text": "4D Write Pro: Apple Writing Tools & Multi-Level Lists",
					"fontFamily": "Arial",
					"fontSize": 30,
					"fontStyle": "bold",
					"horizontalAlignment": "center",
					"verticalAlignment": "center",
					"focusable": false,
					"textAlign": "center",
					"fontWeight": "bold",
					"class": "on-light-bg"
				},
				"WebinarIntro1": {
					"type": "text",
					"top": 412,
					"left": 441,
					"width": 562,
					"height": 56,
					"sizingX": "grow",
					"text": "In the 4D 21 R4 webinar, we explored how Apple Writing Tools work directly inside 4D Write Pro. We saw how to compose, rewrite, and adjust the tone of content without switching applications or managing API keys.",
					"fontFamily": "Arial",
					"fontSize": 16,
					"horizontalAlignment": "left",
					"verticalAlignment": "top",
					"focusable": false,
					"textAlign": "justify",
					"class": "on-light-bg"
				},
				"WebinarIntro1Icon": {
					"type": "picture",
					"top": 413,
					"left": 372,
					"width": 55,
					"height": 55,
					"picture": "/RESOURCES/IntroIcons/WebinarIntro1.png",
					"scalingMode": "scaleToFit",
					"focusable": false,
					"pictureFormat": "scaled"
				},
				"WebinarIntro2": {
					"type": "text",
					"top": 483,
					"left": 441,
					"width": 562,
					"height": 56,
					"sizingX": "grow",
					"text": "We then built a professional Eiffel Tower brochure using multi-level style sheets, predefined templates, custom multi-level styles, toolbar controls, and the multiLevelStyles.json resource file.",
					"fontFamily": "Arial",
					"fontSize": 16,
					"horizontalAlignment": "left",
					"verticalAlignment": "top",
					"focusable": false,
					"textAlign": "justify",
					"class": "on-light-bg"
				},
				"WebinarIntro2Icon": {
					"type": "picture",
					"top": 484,
					"left": 372,
					"width": 55,
					"height": 55,
					"picture": "/RESOURCES/IntroIcons/WebinarIntro2.png",
					"scalingMode": "scaleToFit",
					"focusable": false,
					"pictureFormat": "scaled"
				},
				"WebinarIntro3": {
					"type": "text",
					"top": 573,
					"left": 441,
					"width": 562,
					"height": 19,
					"sizingX": "grow",
					"text": "The final document was customized in 4D Write Pro and exported as a PDF.",
					"fontFamily": "Arial",
					"fontSize": 16,
					"horizontalAlignment": "left",
					"verticalAlignment": "top",
					"focusable": false,
					"textAlign": "justify",
					"class": "on-light-bg"
				},
				"WebinarIntro3Icon": {
					"type": "picture",
					"top": 555,
					"left": 372,
					"width": 55,
					"height": 55,
					"picture": "/RESOURCES/IntroIcons/WebinarIntro3.png",
					"scalingMode": "scaleToFit",
					"focusable": false,
					"pictureFormat": "scaled"
				},
				"GoToDemo": {
					"type": "button",
					"top": 674,
					"left": 538,
					"width": 280,
					"height": 81,
					"title": "Go to demo page",
					"fontFamily": "Arial",
					"fontSize": 16,
					"method": "ObjectMethods/GoToDemo.4dm",
					"events": [
						"onClick"
					],
					"text": "Try it Yourself! →",
					"style": "custom",
					"stroke": "#FFFFFF",
					"textPlacement": "center",
					"imageHugsTitle": false,
					"iconFrames": 1,
					"icon": "/RESOURCES/IntroIcons/WebinarIntro_Button_280x100.png"
				},
				"WebinarIntro_Title": {
					"type": "picture",
